@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />

<div class="hm">

    <!-- HERO -->
    <div class="hm-wrap">
        <section class="hm-hero">
            <span class="hm-badge"><i class="bi bi-stars"></i> LEARN TODAY. LEAD TOMORROW.</span>

            <h1>Build Your Future<br />With <em>Technology.</em></h1>

            <p>
                Turn your passion for technology into real-world skills.
                Learn programming, web development, cybersecurity and
                data science with practical, career-focused training.
            </p>

            <div class="hm-actions">
                <a href="#courses" class="hm-btn hm-btn-solid">
                    <span>Explore Courses</span><i class="bi bi-arrow-right"></i>
                </a>
                <a asp-controller="Student" asp-action="Register" class="hm-btn hm-btn-ghost">
                    <i class="bi bi-people"></i><span>Quick Login / Signup</span>
                </a>
            </div>

            <div class="hm-orb hm-orb-1"></div>
            <div class="hm-orb hm-orb-2"></div>
        </section>
    </div>

