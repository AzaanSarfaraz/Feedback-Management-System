                </div>

                <div class="col-6 col-lg-3 hm-reveal">
                    <div class="hm-card hm-teacher">
                        <div class="hm-photo">
                            <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&h=700&q=85"
                                 alt="Cybersecurity instructor" loading="lazy" />
                        </div>
                        <div class="hm-teacher-info">
                            <h3>Usman Ali</h3>
                            <span>Cyber Security Instructor</span>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3 hm-reveal">
                    <div class="hm-card hm-teacher">
                        <div class="hm-photo">
                            <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=600&h=700&q=85"
