                <div class="col-sm-6 col-lg-3 hm-reveal">
                    <div class="hm-card hm-course">
                        <span class="hm-num">03</span>
                        <div class="hm-icon"><i class="bi bi-shield-lock"></i></div>
                        <h3>Cyber Security</h3>
                        <p>
                            Understand digital security, network protection and
                            the fundamentals of defending systems against cyber threats.
                        </p>
                        <a href="#feedback" class="hm-link">Learn More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3 hm-reveal">
                    <div class="hm-card hm-course">
                        <span class="hm-num">04</span>
                        <div class="hm-icon"><i class="bi bi-bar-chart-line"></i></div>
                        <h3>Data Science</h3>
                        <p>
                            Explore data analysis, visualization, statistics and
                            the foundations of data-driven decision-making.
                        </p>
                        <a href="#feedback" class="hm-link">Learn More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FEEDBACK BANNER -->
    <section class="hm-section hm-section-tight" id="feedback">
        <div class="hm-wrap">
            <div class="hm-banner hm-reveal">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
