    <!-- VIDEO -->
    <section class="hm-section" id="about">
        <div class="hm-wrap">

            <div class="hm-head hm-reveal">
                <span class="hm-tag">Discover Our World</span>
                <h2>Learn. Create. Innovate.</h2>
                <p>
                    Explore the exciting world of computer science and
                    discover how technology can transform ideas into reality.
                </p>
            </div>

            <div class="hm-card hm-video hm-reveal">
                <iframe src="https://www.youtube-nocookie.com/embed/8mAITcNt710"
                        title="Introduction to Computer Science - Harvard CS50"
                        loading="lazy"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            </div>

        </div>
    </section>

</div>

<script>
    (function () {
        var root = document.querySelector(".hm");
        var items = document.querySelectorAll(".hm .hm-reveal");
        if (!root) return;

        if (!("IntersectionObserver" in window)) return; // content stays visible

        root.classList.add("hm-js");

        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });

        items.forEach(function (el) { observer.observe(el); });
    })();
</script>